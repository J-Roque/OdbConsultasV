# Normaliza finales de linea: LF en el repositorio, nativo al hacer checkout.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.onnx binary
*.dll binary
*.pyd binary

uv.lock linguist-generated=true -diff
