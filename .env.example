# Copia este archivo como .env y completa los valores. .env esta en .gitignore:
# nunca lo subas ni pegues su contenido en issues, PRs o capturas.
#
#   Copy-Item .env.example .env
#   uv run obd-consultas token     # genera un valor para OBD_API_TOKEN

# --- API (obligatorio para `serve`) ---------------------------------------
# Token compartido con el cliente (APK) en la cabecera X-OBD-Token.
# Minimo 32 caracteres. Sin token valido las rutas /v1/* responden 503.
OBD_API_TOKEN=

# Peticiones por minuto y por IP en /v1/* (1-10000). Por defecto 30.
OBD_API_RATE_LIMIT=30

# Consultas (stealth/asistidas) en curso a la vez (1-100). Por defecto 5.
OBD_API_MAX_ACTIVE_JOBS=5

# 1 = publica /docs, /redoc y /openapi.json. Dejar en 0 fuera de desarrollo.
OBD_API_DOCS=0

# 1 = habilita POST /v1/queries/assisted, que abre un navegador VISIBLE en esta PC.
OBD_API_ASSISTED=0

# --- Navegador sigiloso (opcional) ----------------------------------------
# Proxy para --stealth y extract. Si lleva credenciales, ponlas solo aqui,
# nunca en la linea de comandos. Formato: http://usuario:clave@host:puerto
OBD_PROXY_URL=

# --- Depuracion de conectores (opcional) -----------------------------------
# Carpeta donde los conectores provisionales (hoy: SAT) guardan el HTML crudo
# de la respuesta para ajustar el parser. Puede traer datos de la placa:
# usa una carpeta ignorada por git, por ejemplo artifacts/debug. Vacio = no guarda.
OBD_DEBUG_DIR=
